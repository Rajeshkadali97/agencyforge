{
  "name": "@agencyforge/runtime",
  "version": "1.0.0",
  "description": "AgencyForge Runtime - Operating system that boots and orchestrates AgencyForge",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "start:dev": "node --watch dist/cli.js"
  },
  "keywords": [
    "agencyforge",
    "runtime",
    "orchestration",
    "workflow"
  ],
  "author": "AgencyForge",
  "license": "MIT",
  "dependencies": {
    "@agencyforge/memory-engine": "workspace:*",
    "@agencyforge/research": "workspace:*",
    "better-sqlite3": "^12.6.2",
    "firecrawl": "^4.51.0",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
