# ── AgencyForge Runtime — Environment Variables ──────────────────────────────────
# Copy to .env and fill in real values before starting.
# Never commit .env to source control.

# ── Server ────────────────────────────────────────────────────────────────────
# Port the RuntimeBridge HTTP server listens on (default: 3001)
RUNTIME_PORT=3001

# Node environment: development | production | test
NODE_ENV=development

# ── Security ──────────────────────────────────────────────────────────────────
# Optional bearer token protecting all non-public endpoints.
# Leave unset to disable auth (development only).
RUNTIME_API_KEY=

# Allowed CORS origin. Use specific domain in production.
# In development defaults to '*'. In production, set this explicitly.
CORS_ORIGIN=http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Database (Persistence) ────────────────────────────────────────────────────
# SQLite file path. When unset, persistence is disabled (in-memory only).
# Relative paths are resolved from the runtime working directory.
AGENCYFORGE_DB_PATH=./data/agencyforge.db

# ── AI Providers ─────────────────────────────────────────────────────────────
# 9Router (local proxy — recommended; routes to all providers below)
NINE_ROUTER_URL=http://localhost:20128/v1

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# NVIDIA NIM
NIM_API_KEY=

# Ollama (local; no key needed)
OLLAMA_URL=http://localhost:11434

# ── Lead Generation / Research ────────────────────────────────────────────────
FIRECRAWL_API_KEY=
SERPER_API_KEY=
APOLLO_API_KEY=
GOOGLE_MAPS_API_KEY=
LINKEDIN_ACCESS_TOKEN=

# ── Voice (STT/TTS) ───────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Plugins ───────────────────────────────────────────────────────────────────
FLOWISE_URL=http://localhost:3000
PAPERCLIP_URL=http://localhost:4000
