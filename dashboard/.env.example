# ── AgencyForge Dashboard — Environment Variables ────────────────────────────────
# Copy to .env.local for local development.
# Never commit .env.local to source control.

# ── Runtime Connection ────────────────────────────────────────────────────────
# Base URL of the AgencyForge Runtime (RuntimeBridge HTTP server).
NEXT_PUBLIC_RUNTIME_URL=http://localhost:3001

# Internal server-side proxy target for /api/runtime/stream route.
RUNTIME_BRIDGE_URL=http://localhost:3001

# ── Analytics / Telemetry ─────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1

# ── Personalisation ───────────────────────────────────────────────────────────
# Name shown in the sidebar and the greeting on the HQ screen.
NEXT_PUBLIC_OPERATOR_NAME=Operator

# ── Server-side runtime access (never use a NEXT_PUBLIC_ prefix here) ─────────
# The dashboard server proxies mission, API-catalog and routing calls to the runtime
# and attaches this key. It is never sent to the browser.
RUNTIME_URL=http://localhost:3001
RUNTIME_API_KEY=
