# AgencyForge Environment Variables
# Copy this file to .env and fill in your values.
# All API keys are optional — AgencyForge uses free-tier providers by default.

# ── 9Router (Primary AI Gateway) ──────────────────────────────────────────────
# Local AI gateway — routes all requests to the best provider.
# Start: npx 9router   (listens at localhost:20128 by default)
NINE_ROUTER_URL=http://localhost:20128/v1
NINE_ROUTER_DEFAULT_MODEL=kr/claude-haiku-4-5-20251001

# ── AI Provider Keys ──────────────────────────────────────────────────────────
# Fallbacks used only when 9Router is not running.

# OpenRouter (free models available — https://openrouter.ai)
OPENROUTER_API_KEY=

# Google Gemini (free tier available — https://aistudio.google.com)
GEMINI_API_KEY=
GOOGLE_GEMINI_API_KEY=

# NVIDIA NIM (free credits available — https://build.nvidia.com)
NIM_API_KEY=
NVIDIA_NIM_API_KEY=

# Anthropic Claude (paid — https://console.anthropic.com)
ANTHROPIC_API_KEY=

# OpenAI (paid — https://platform.openai.com)
OPENAI_API_KEY=

# Local Ollama (free, self-hosted — https://ollama.ai)
OLLAMA_BASE_URL=http://localhost:11434

# ── Web Scraping ───────────────────────────────────────────────────────────────
# Firecrawl (free tier available — https://firecrawl.dev)
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev

# ── Revenue Engine Providers ──────────────────────────────────────────────────
# Serper.dev (Google Search API — 1000 free/month — https://serper.dev)
SERPER_API_KEY=

# Apollo.io (B2B company + people data — https://apollo.io)
APOLLO_API_KEY=

# Google Maps Places API (business discovery — https://console.cloud.google.com)
GOOGLE_MAPS_API_KEY=

# LinkedIn (pre-obtained OAuth 2.0 bearer token — complete OAuth flow separately)
LINKEDIN_ACCESS_TOKEN=

# ── Flowise (Visual Workflow Designer) ────────────────────────────────────────
# Self-hosted Flowise instance — workflow.list / workflow.execute / workflow.import
FLOWISE_API_URL=http://localhost:3000
FLOWISE_API_KEY=

# ── Paperclip (Org Intelligence Layer) ────────────────────────────────────────
# Self-hosted Paperclip instance — org hierarchy, team management, goal assignment
PAPERCLIP_API_URL=http://localhost:4000
PAPERCLIP_API_KEY=

# ── Runtime ────────────────────────────────────────────────────────────────────
# Path to the SQLite database used by the runtime state store and memory engine.
AGENCYFORGE_DB_PATH=./data/agencyforge.db

# ── Runtime Security ───────────────────────────────────────────────────────────
# CORS_ORIGIN: allowed origin for RuntimeBridge HTTP responses.
#   In production set to your dashboard origin: https://app.myagent.com
#   Omit (or set to *) for local development.
CORS_ORIGIN=*

# RUNTIME_API_KEY: bearer token required on all non-public RuntimeBridge endpoints.
#   When set, clients must include: Authorization: Bearer <value>
#   Leave empty to disable auth (development only).
RUNTIME_API_KEY=

# RATE_LIMIT_MAX: max requests per IP per window (default 100).
RATE_LIMIT_MAX=100

# RATE_LIMIT_WINDOW_MS: sliding window duration in milliseconds (default 60000 = 1 minute).
RATE_LIMIT_WINDOW_MS=60000

# ── Dashboard ──────────────────────────────────────────────────────────────────
# Base URL of the RuntimeBridge HTTP server (no trailing slash, no path).
NEXT_PUBLIC_RUNTIME_URL=http://localhost:3001
NEXT_PUBLIC_RUNTIME_BRIDGE_URL=http://localhost:3001
RUNTIME_BRIDGE_URL=http://localhost:3001/api/runtime/stream

# ── Personalisation ───────────────────────────────────────────────────────────
# Name shown in the dashboard sidebar and HQ greeting.
NEXT_PUBLIC_OPERATOR_NAME=Operator
